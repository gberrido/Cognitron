# Cognitron06 Environment Configuration
# Copy this file to .env and fill in your values

# ================================
# REQUIRED: Groq API Configuration
# ================================
GROQ_API_KEY=your_groq_api_key_here

# ================================
# Server Configuration
# ================================
COGNITRON_HOST=0.0.0.0
COGNITRON_PORT=8000
COGNITRON_DEBUG=false

# ================================
# Security Configuration
# ================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COGNITRON_SECRET_KEY=your-secret-key-for-jwt-tokens

# ================================
# Model Configuration
# ================================
COGNITRON_MODEL=openai/gpt-oss-120b
COGNITRON_MAX_TOKENS=2048
COGNITRON_TEMPERATURE=0.7

# ================================
# Memory System Configuration
# ================================
COGNITRON_DATA_DIR=./cognitron06-data
COGNITRON_MAX_WORKING_CONTEXT=2000
COGNITRON_MAX_FIFO_QUEUE=20
COGNITRON_MEMORY_PRESSURE=0.8
COGNITRON_CONTEXT_WINDOW=8192

# ================================
# Logging Configuration
# ================================
COGNITRON_LOG_LEVEL=INFO

# ================================
# Database Configuration (Future)
# ================================
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=cognitron06
# POSTGRES_USER=cognitron
# POSTGRES_PASSWORD=changeme

# ================================
# Redis Configuration (Future)
# ================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0