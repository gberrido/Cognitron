# Cognitron05 Environment Variables Example
# Copy this file to .env and fill in your actual values

# REQUIRED: Groq API Key
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# OPTIONAL: Override default model (default: openai/gpt-oss-120b)
# GROQ_MODEL=qwen/qwen3-32b

# OPTIONAL: Override default temperature (default: 0.7)
# TEMPERATURE=0.5

# OPTIONAL: Enable debug logging (default: false)
# DEBUG=true

# OPTIONAL: Memory system settings
# MEMORY_ENABLED=true
# MAX_FIFO_QUEUE_SIZE=20
# MEMORY_PRESSURE_THRESHOLD=0.8